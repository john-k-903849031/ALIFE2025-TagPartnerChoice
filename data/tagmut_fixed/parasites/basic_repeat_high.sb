#!/bin/bash --login

## Job name settings
#SBATCH --job-name=para_high
#SBATCH -o para_high%A_%a.out

## Time requirement in hours and minutes. You might need to make this
## longer, but try to keep it under 4 hours if possible
#SBATCH --time=0-5:50

## Memory requirement in megabytes. You might need to make this bigger.
#SBATCH --mem-per-cpu=800M                                                   

## Launch an array of jobs.
#SBATCH --array=1001-1240

l=(0.4375 0.5 0.5625) # only do second half here...
m=(0 0.0001 0.0005  0.001 0.005 0.01 0.05 0.1) # point mutation prob

m_i=$((${SLURM_ARRAY_TASK_ID}%${#m[@]}))
tm=${m[$m_i]}

for td in "${l[@]}";
do
	filename="_TD$td""_TM$tm""_data"
        args=" -TAG_DISTANCE $td -TAG_MUTATION_SIZE $tm -SEED ${SLURM_ARRAY_TASK_ID} -FILE_NAME $filename"
        ./symbulation_default $args > run.log
done

